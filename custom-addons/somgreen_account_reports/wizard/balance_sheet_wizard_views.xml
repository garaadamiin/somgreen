<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_somgreen_balance_sheet_wizard" model="ir.ui.view">
        <field name="name">somgreen.balance.sheet.wizard.form</field>
        <field name="model">somgreen.balance.sheet.wizard</field>
        <field name="arch" type="xml">
            <form string="Balance Sheet">
                <group>
                    <group>
                        <field name="date_to"/>
                        <field name="target_move" widget="radio"/>
                    </group>
                    <group>
                        <field name="show_accounts"/>
                        <field name="hide_zero_lines"/>
                    </group>
                </group>
                <group string="Restrict to Journals (optional)">
                    <field name="journal_ids" nolabel="1" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print"
                            type="object" default_focus="1"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_view_html" string="Preview"
                            type="object" class="btn-secondary" data-hotkey="w"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_somgreen_balance_sheet" model="ir.actions.act_window">
        <field name="name">Balance Sheet</field>
        <field name="res_model">somgreen.balance.sheet.wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_somgreen_balance_sheet_wizard"/>
        <field name="target">new</field>
    </record>

</odoo>
