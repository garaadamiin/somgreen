<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Two actions over ONE template. The PDF is the deliverable; the HTML
        variant lets the accountant read the statement on screen before
        committing it to paper.
    -->

    <record id="action_report_balance_sheet_pdf" model="ir.actions.report">
        <field name="name">Balance Sheet</field>
        <field name="model">somgreen.balance.sheet.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">somgreen_account_reports.report_balance_sheet</field>
        <field name="report_file">somgreen_account_reports.report_balance_sheet</field>
        <field name="paperformat_id" ref="paperformat_somgreen_financial_report"/>
        <field name="print_report_name">'Balance Sheet - %s' % (object.date_to or '')</field>
    </record>

    <record id="action_report_balance_sheet_html" model="ir.actions.report">
        <field name="name">Balance Sheet (Preview)</field>
        <field name="model">somgreen.balance.sheet.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">somgreen_account_reports.report_balance_sheet</field>
        <field name="report_file">somgreen_account_reports.report_balance_sheet</field>
    </record>

    <record id="action_report_profit_and_loss_pdf" model="ir.actions.report">
        <field name="name">Profit and Loss</field>
        <field name="model">somgreen.profit.loss.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">somgreen_account_reports.report_profit_and_loss</field>
        <field name="report_file">somgreen_account_reports.report_profit_and_loss</field>
        <field name="paperformat_id" ref="paperformat_somgreen_financial_report"/>
        <field name="print_report_name">'Profit and Loss - %s to %s' % (object.date_from or '', object.date_to or '')</field>
    </record>

    <record id="action_report_profit_and_loss_html" model="ir.actions.report">
        <field name="name">Profit and Loss (Preview)</field>
        <field name="model">somgreen.profit.loss.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">somgreen_account_reports.report_profit_and_loss</field>
        <field name="report_file">somgreen_account_reports.report_profit_and_loss</field>
    </record>

</odoo>
