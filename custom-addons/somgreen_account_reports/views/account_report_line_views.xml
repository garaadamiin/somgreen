<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        The report structure, exposed so the accountant can rename a caption,
        resequence a section or add a line without a developer. The data file is
        noupdate="1", so edits made here survive a module upgrade.
    -->

    <record id="view_somgreen_account_report_line_list" model="ir.ui.view">
        <field name="name">somgreen.account.report.line.list</field>
        <field name="model">somgreen.account.report.line</field>
        <field name="arch" type="xml">
            <list string="Report Lines" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="report_key"/>
                <field name="parent_id"/>
                <field name="level"/>
                <field name="line_type"/>
                <field name="account_type_codes" optional="show"/>
                <field name="formula" optional="show"/>
                <field name="effective_sign" optional="show"/>
                <field name="show_accounts" optional="hide"/>
                <field name="hide_if_zero" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_somgreen_account_report_line_form" model="ir.ui.view">
        <field name="name">somgreen.account.report.line.form</field>
        <field name="model">somgreen.account.report.line</field>
        <field name="arch" type="xml">
            <form string="Report Line">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="report_key"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="line_type"/>
                            <field name="account_type_codes"
                                   invisible="line_type != 'account_type'"
                                   required="line_type == 'account_type'"/>
                            <field name="formula" placeholder="e.g. PL_INCOME - PL_EXPENSES"
                                   invisible="line_type != 'aggregate'"
                                   required="line_type == 'aggregate'"/>
                            <field name="sign"/>
                            <field name="effective_sign"/>
                        </group>
                    </group>
                    <group string="Presentation">
                        <group>
                            <field name="level"/>
                            <field name="style_override"/>
                        </group>
                        <group>
                            <field name="show_accounts"
                                   invisible="line_type != 'account_type'"/>
                            <field name="hide_if_zero"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Children" name="children">
                            <field name="child_ids" nolabel="1" readonly="1">
                                <list default_order="sequence, id">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="line_type"/>
                                    <field name="account_type_codes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_somgreen_account_report_line_search" model="ir.ui.view">
        <field name="name">somgreen.account.report.line.search</field>
        <field name="model">somgreen.account.report.line</field>
        <field name="arch" type="xml">
            <search string="Report Lines">
                <field name="name"/>
                <field name="code"/>
                <field name="account_type_codes"/>
                <field name="report_key"/>
                <filter string="Balance Sheet" name="filter_bs"
                        domain="[('report_key', '=', 'balance_sheet')]"/>
                <filter string="Profit and Loss" name="filter_pl"
                        domain="[('report_key', '=', 'profit_and_loss')]"/>
                <filter string="Top Level" name="filter_roots" domain="[('parent_id', '=', False)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Statement" name="group_report"
                            domain="[]" context="{'group_by': 'report_key'}"/>
                    <filter string="Parent" name="group_parent"
                            domain="[]" context="{'group_by': 'parent_id'}"/>
                    <filter string="Type" name="group_type"
                            domain="[]" context="{'group_by': 'line_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_somgreen_account_report_line" model="ir.actions.act_window">
        <field name="name">Financial Report Structure</field>
        <field name="res_model">somgreen.account.report.line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_somgreen_account_report_line_search"/>
        <field name="context">{'search_default_group_report': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No report lines yet
            </p>
            <p>
                These records describe the shape of the Balance Sheet and the
                Profit and Loss: the sections, their order, and which account
                types feed each one.
            </p>
        </field>
    </record>

</odoo>
